# Placeholder values only. Copy privately to ignored .env.local.
TMDB_READ_ACCESS_TOKEN=replace_privately
# Optional alternative if Bearer token is not configured
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
SUPABASE_URL=replace_privately
SUPABASE_SECRET_KEY=replace_privately
# Optional legacy service_role JWT fallback; never use anon/publishable keys here.
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
RATE_LIMIT_HASH_SECRET=generate_random_secret_privately
