{
  "name": "reelclue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "db:purge": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env.local scripts/purge-expired.ts",
    "catalog:sync": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env.local scripts/catalog-sync.ts",
    "verify:deployment": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env.local scripts/verify-deployment.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
